generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("agent")
  createdAt DateTime @default(now())
  
  investigationLogs InvestigationLog[]
  reports        CaseReport[]
}

model Case {
  id                String   @id @default(cuid())
  caseNumber        String   @unique
  title             String
  description       String
  
  type              String
  status            String
  
  classification    String
  priority          String
  
  location          String
  date              String
  time              String
  
  reportingAgent    String
  handler           String?
  involvedAgents    String?
  teamMembers       String?
  
  actionsTaken      String?
  recommendedNextStep String?
  
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  closedAt          DateTime?
  
  phase            String?
  riskLevel        String?
  budget           Float?
  duration         Int?
  
  tags             String?
  intelligenceValue String?
  threatLevel      String?
  
  operationType    String?
  operationStatus  String?
  
  auditTrail       String?
  
  suspects          Suspect[]
  victims           Victim[]
  witnesses         Witness[]
  evidences         Evidence[]
  timelineEvents    TimelineEvent[]
  reports           CaseReport[]
  investigationLogs InvestigationLog[]
  relationships     Relationship[]
}

model CaseReport {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  reportType        String
  reportNumber      Int
  
  title             String
  executiveSummary  String?
  detailedReport    String?
  
  findings          String?
  recommendations   String?
  
  attachments       String?
  classification   String   @default("CONFIDENTIAL")
  
  authorId          String?
  author            User? @relation(fields: [authorId], references: [id])
  
  status            String   @default("draft")
  
  reviewedBy        String?
  reviewedAt        DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Suspect {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  fullName          String
  alias             String?
  dateOfBirth       String?
  gender            String?
  nationality       String?
  height            String?
  weight            String?
  eyeColor          String?
  hairColor          String?
  threatLevel       String
  status            String
  description       String?
  distinguishingMarks String?
  address           String?
  phone             String?
  email             String?
  criminalHistory   String?
  wantedStatus      Boolean  @default(false)
  imageUrl          String?
  createdAt         DateTime @default(now())
}

model Victim {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  fullName          String
  alias             String?
  dateOfBirth       String?
  gender            String?
  nationality       String?
  address           String?
  phone             String?
  email             String?
  status            String
  description       String?
  medicalNotes      String?
  imageUrl          String?
  createdAt         DateTime @default(now())
}

model Witness {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  fullName          String
  alias             String?
  address           String?
  phone             String?
  email             String?
  statement         String?
  statementDate     String?
  statementTime     String?
  credibility       String
  reliabilityScore  Int?
  description       String?
  protectionStatus  String?
  createdAt         DateTime @default(now())
}

model TimelineEvent {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  title             String
  description       String
  eventTime         String
  eventDate         String?
  type              String
  classification    String   @default("CONFIDENTIAL")
  source            String?
  location          String?
  evidenceIds       String?
  verified          Boolean  @default(false)
  verifiedBy        String?
  verifiedAt        DateTime?
  createdBy         String?
  createdAt         DateTime @default(now())
}

model InvestigationLog {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  message           String
  type              String
  createdBy         String
  author            User? @relation(fields: [createdBy], references: [id])
  createdAt         DateTime @default(now())
}

model Evidence {
  id                String   @id @default(cuid())
  caseId            String?
  case              Case?  @relation(fields: [caseId], references: [id])
  
  title             String
  description       String
  evidenceType      String
  classification    String
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  weapon            WeaponEvidence?
  car               CarEvidence?
  imageEvidence     ImageEvidence?
  document          DocumentEvidence?
  relationships     EvidenceRelationship[] @relation("SourceEvidence")
  targetRelationships EvidenceRelationship[] @relation("TargetEvidence")
}

model WeaponEvidence {
  id                String   @id @default(cuid())
  evidenceId        String   @unique
  evidence          Evidence @relation(fields: [evidenceId], references: [id])
  weaponType        String
  brand             String?
  model             String?
  serialNumber      String?
  caliber           String?
  condition         String?
  quality           String?
  owner             String?
  registeredOwner   String?
  licenseStatus     String?
  seizedFrom        String?
  seizureLocation   String?
  seizureDate       String?
  chainOfCustody    String?
  model3dUrl        String?
  model3dType       String?
  organ             Boolean  @default(false)
  images            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CarEvidence {
  id                String   @id @default(cuid())
  evidenceId        String   @unique
  evidence          Evidence @relation(fields: [evidenceId], references: [id])
  vehicleType       String?
  make              String?
  model             String?
  year              Int?
  trim              String?
  plateNumber       String?
  plateState        String?
  vin               String?
  color             String?
  interiorColor     String?
  bodyStyle         String?
  owner             String?
  registeredOwner   String?
  insuranceStatus   String?
  condition         String?
  mileage           Int?
  damage            String?
  seizedFrom        String?
  seizureLocation   String?
  seizureDate       String?
  model3dUrl        String?
  model3dType       String?
  images            String?
  currentStatus     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ImageEvidence {
  id                String   @id @default(cuid())
  evidenceId        String   @unique
  evidence          Evidence @relation(fields: [evidenceId], references: [id])
  imageUrl          String?
  thumbnailUrl      String?
  originalFilename  String?
  fileSize          Int?
  fileType          String?
  dimensions        String?
  caption           String?
  locationTaken     String?
  dateTaken         String?
  cameraModel       String?
  gpsCoordinates    String?
  contentType       String?
  containsFaces     Boolean?
  facesDetected     Int?
  facesIdentified   String?
  analysisNotes     String?
  enhancementApplied Boolean?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DocumentEvidence {
  id                String   @id @default(cuid())
  evidenceId        String   @unique
  evidence          Evidence @relation(fields: [evidenceId], references: [id])
  documentType      String?
  title             String?
  documentNumber    String?
  fileUrl           String?
  fileSize          Int?
  fileType          String?
  pages             Int?
  summary           String?
  keyParties        String?
  dateIssued        String?
  dateExpires       String?
  issuingAuthority  String?
  securityLevel     String?
  verified          Boolean?
  verificationNotes String?
  analysisNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EvidenceRelationship {
  id                String   @id @default(cuid())
  sourceEvidenceId  String
  sourceEvidence    Evidence @relation("SourceEvidence", fields: [sourceEvidenceId], references: [id])
  targetEvidenceId  String
  targetEvidence    Evidence @relation("TargetEvidence", fields: [targetEvidenceId], references: [id])
  relationshipType  String
  description       String?
  confidence        String?
  createdAt         DateTime @default(now())
}

model Board {
  id            String @id @default(cuid())
  title         String
  description   String?
  classification String @default("CONFIDENTIAL")
  ownerId       String
  createdAt     DateTime @default(now())
  nodes         GraphNode[]
  edges         GraphEdge[]
}

model GraphNode {
  id            String @id @default(cuid())
  boardId       String
  board         Board @relation(fields: [boardId], references: [id])
  nodeType      String
  title         String
  subtitle      String?
  classification String @default("CONFIDENTIAL")
  x             Float
  y             Float
  metadata      String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

model GraphEdge {
  id            String @id @default(cuid())
  boardId       String
  board         Board @relation(fields: [boardId], references: [id])
  source        String
  target        String
  label         String?
  animated      Boolean @default(true)
  createdAt     DateTime @default(now())
}

model Relationship {
  id            String   @id @default(uuid())
  sourceId      String
  sourceType    String
  targetId      String
  targetType    String
  label         String
  caseId        String
  case          Case @relation(fields: [caseId], references: [id])
  createdAt     DateTime @default(now())
}
